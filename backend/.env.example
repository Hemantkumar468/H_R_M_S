# Node Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (MongoDB Atlas) - accepts MONGO_URI or MONGODB_URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hrms?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hrms?retryWrites=true&w=majority

# Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=cookie_secret_key_hrms_at_least_32_characters_long

# Super Admin Initial Credentials (for Seed script)
SUPER_ADMIN_EMAIL=superadmin@hrms.local
SUPER_ADMIN_PASSWORD=SuperAdmin@12345
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=Admin

# Mailer (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@hrms.local

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
